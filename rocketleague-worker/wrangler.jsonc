{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "petrock-rocketleague",
	"main": "worker.mjs",
	"compatibility_date": "2026-10-05",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "https://petrock.dev,https://www.petrock.dev",
		"PUBLIC_URL": "https://petrock.dev/rocketleague/"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "petrock-rocketleague",
			"database_id": "ea62057b-2eb1-464f-b9f1-376f4db24695",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	}
}
